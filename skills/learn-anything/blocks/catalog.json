{
  "schemaVersion": 1,
  "blocks": [
    {
      "id": "server.node-sse",
      "kind": "server",
      "path": "blocks/server/server.mjs",
      "requires": ["node>=20"],
      "provides": ["http-server", "sse-events", "message-queue", "state-persistence", "stage-api"],
      "smokeCheck": "node bin/learn-anything.mjs smoke --session <session-dir>"
    },
    {
      "id": "web.dynamic-stage",
      "kind": "frontend",
      "path": "blocks/web/dist",
      "requires": ["built-web-assets"],
      "provides": ["mentor-stream", "dynamic-stage", "subject-editor", "structured-table", "annotated-passage", "figure", "parameter-controls", "quiz-actions", "diagram-rendering"],
      "smokeCheck": "GET / and GET /app.js return 200"
    },
    {
      "id": "adapter.claude-agent-sdk",
      "kind": "mentor-adapter",
      "path": "blocks/adapters/claude-agent-sdk/adapter.mjs",
      "requires": ["claude-agent-sdk-auth", "node>=20"],
      "provides": ["persistent-mentor", "token-streaming", "session-resume", "stage-tool", "milestone-tool"],
      "smokeCheck": "event mapper tests plus authenticated launch check"
    },
    {
      "id": "adapter.shell-long-poll",
      "kind": "mentor-adapter",
      "path": "scripts/mentor.mjs",
      "requires": ["shell", "node>=20"],
      "provides": ["browser-to-agent-messages", "agent-to-browser-events", "stage-updates"],
      "degraded": ["no-token-streaming-guarantee", "agent-turn-long-poll"],
      "smokeCheck": "message round trip through /api/mentor/next and /api/mentor/event"
    },
    {
      "id": "adapter.codex-cli",
      "kind": "mentor-adapter",
      "path": "blocks/adapters/codex-cli/adapter.mjs",
      "requires": ["codex-cli-auth", "node>=20"],
      "provides": ["persistent-mentor", "session-resume", "stage-updates"],
      "degraded": ["turn-complete-output"],
      "smokeCheck": "real browser message reaches codex exec and returns mentor text"
    },
    {
      "id": "execution.host-fixed-runners",
      "kind": "execution",
      "path": "blocks/execution/host-runner.mjs",
      "requires": ["one-supported-toolchain"],
      "provides": ["code-run", "stdout", "stderr", "exit-code"],
      "degraded": ["host-execution"],
      "smokeCheck": "run JavaScript probe in session exercises directory"
    },
    {
      "id": "execution.sqlite",
      "kind": "execution",
      "path": "blocks/execution/sqlite-runner.mjs",
      "requires": ["python3-with-sqlite"],
      "provides": ["run:sql", "hidden-fixtures", "structured-table-results"],
      "degraded": ["host-execution"],
      "smokeCheck": "run a pure SQL query against an in-memory seeded fixture"
    }
  ]
}
